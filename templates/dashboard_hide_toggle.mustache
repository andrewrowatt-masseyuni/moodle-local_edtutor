{{!
    @template local_edtutor/dashboard_hide_toggle

    Hide or show toggle for one assessment on the Education Tutor dashboard.

    When the assessment is not hidden a danger-styled Hide button links to a
    confirmation page. When it is hidden a default-styled Show button links
    directly (the URL carries a sesskey) to reveal it again.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * assesshidden - Whether the tutor has hidden this assessment.
    * hideurl - URL of the hide confirmation page for this assessment.
    * showurl - URL that shows this assessment again (includes sesskey).

    Example context (json):
    {
        "assesshidden": false,
        "hideurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=12&action=hide",
        "showurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=12&action=show&sesskey=xyz"
    }
}}
{{#assesshidden}}
    <a class="btn btn-outline-secondary btn-sm mr-1" href="{{showurl}}">
        <i class="fa-solid fa-eye" aria-hidden="true"></i>
        <span class="sr-only">{{#str}} show {{/str}}</span>
    </a>
{{/assesshidden}}
{{^assesshidden}}
    <a class="btn btn-outline-danger btn-sm mr-1" href="{{hideurl}}">
        <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
        <span class="sr-only">{{#str}} hide {{/str}}</span>
    </a>
{{/assesshidden}}
