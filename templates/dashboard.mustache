{{!
    @template local_edtutor/dashboard

    Education Tutor dashboard with a by-student and a by-course view.

    Both views are rendered; the view select shows one at a time and the
    choice is saved as a user preference by the local_edtutor/dashboard AMD
    module. The same module filters both views client side from the student,
    course and status (timeframe) selects. Only one of the student and course
    filters is active at a time (the module resets the other), and the
    timeframe's initial state is rendered server side and persisted as a user
    preference.

    Classes required for JS:
    * local_edtutor-hidden - Marker class applied to filtered-out elements.

    Data attributes required for JS:
    * data-region="local_edtutor-dashboard"
    * data-action="local_edtutor-viewtoggle"
    * data-action="local_edtutor-filterstudent"
    * data-action="local_edtutor-filtercourse"
    * data-action="local_edtutor-timeframe"
    * data-region="local_edtutor-view-bystudent"
    * data-region="local_edtutor-view-bycourse"
    * data-region="local_edtutor-nomatches"

    Context variables required for this template:
    * bystudentactive - Whether the by-student view is shown initially.
    * bycourseactive - Whether the by-course view is shown initially.
    * canloginas - Whether login on behalf actions are shown.
    * cansubmit - Whether submit on behalf actions are shown.
    * cansetpreferences - Whether the set student preferences action is shown.
    * preferencesurl - URL of the student preferences page.
    * hasstudents - Whether any students are allocated to the tutor.
    * students - Student cards, see local_edtutor/dashboard_student_card.
    * hascourses - Whether any allocated student is enrolled in a course.
    * courses - Course cards, see local_edtutor/dashboard_course_card.
    * filterstudents - Student filter options with id and label.
    * filtercourses - Course filter options with id and fullname.
    * tfallselected - Whether the 'all' timeframe option is selected.
    * tfduesoonselected - Whether the 'duesoon' timeframe option is selected.
    * tfoverdueselected - Whether the 'overdue' timeframe option is selected.
    * bystudentempty - Whether the timeframe filter hides every student card.
    * bycourseempty - Whether the timeframe filter hides every course card.

    Example context (json):
    {
        "bystudentactive": true,
        "bycourseactive": false,
        "canloginas": true,
        "cansubmit": true,
        "cansetpreferences": true,
        "preferencesurl": "https://example.com/local/edtutor/preferences.php",
        "filterstudents": [
            {
                "id": 3,
                "label": "Student One (27010001)"
            }
        ],
        "filtercourses": [
            {
                "id": 5,
                "fullname": "Course 1"
            }
        ],
        "tfallselected": false,
        "tfduesoonselected": true,
        "tfoverdueselected": false,
        "bystudentempty": false,
        "bycourseempty": false,
        "hasstudents": true,
        "students": [
            {
                "id": 3,
                "fullname": "Student One",
                "username": "27010001",
                "lastaccess": "Tuesday, 1 July 2025, 9:00 AM",
                "overdue": true,
                "loginasurl": "https://example.com/local/edtutor/loginas.php?userid=3&sesskey=xyz",
                "hascourses": true,
                "courses": [
                    {
                        "id": 5,
                        "fullname": "Course 1",
                        "loginasurl": "https://example.com/local/edtutor/loginas.php?userid=3&courseid=5&sesskey=xyz",
                        "lastaccess": "Tuesday, 1 July 2025, 9:00 AM",
                        "hasactivities": true,
                        "hasdueactivities": true,
                        "activities": [
                            {
                                "cmid": 12,
                                "name": "Assignment 1",
                                "iconclass": "fa-solid fa-file-pen",
                                "submittable": true,
                                "submitted": false,
                                "hasduedate": true,
                                "duedate": "Friday, 4 July 2025, 5:00 PM",
                                "extension": true,
                                "overdue": true,
                                "submiturl": "https://example.com/local/edtutor/submit.php?studentid=3&courseid=5&cmid=12"
                            }
                        ],
                        "hasnoduedate": true,
                        "noduedateactivities": [
                            {
                                "cmid": 13,
                                "name": "Quiz 1",
                                "iconclass": "fa-solid fa-clipboard-question",
                                "submittable": false,
                                "submitted": false,
                                "hasduedate": false,
                                "duedate": "",
                                "extension": false,
                                "overdue": false,
                                "submiturl": "https://example.com/local/edtutor/submit.php?studentid=3&courseid=5&cmid=13"
                            }
                        ]
                    }
                ]
            }
        ],
        "hascourses": true,
        "courses": [
            {
                "id": 5,
                "fullname": "Course 1",
                "overdue": true,
                "hasactivities": true,
                "hasdueactivities": true,
                "activities": [
                    {
                        "cmid": 12,
                        "name": "Assignment 1",
                        "iconclass": "fa-solid fa-file-pen",
                        "submittable": true,
                        "students": [
                            {
                                "id": 3,
                                "fullname": "Student One",
                                "username": "27010001",
                                "submitted": false,
                                "hasduedate": true,
                                "duedate": "Friday, 4 July 2025, 5:00 PM",
                                "extension": true,
                                "overdue": true,
                                "submittable": true,
                                "loginasurl": "https://example.com/local/edtutor/loginas.php?userid=3&sesskey=xyz",
                                "submiturl": "https://example.com/local/edtutor/submit.php?studentid=3&courseid=5&cmid=12"
                            }
                        ]
                    }
                ],
                "hasnoduedate": false,
                "noduedateactivities": []
            }
        ]
    }
}}
<div class="local_edtutor-dashboard" data-region="local_edtutor-dashboard">
    <div class="d-flex flex-wrap align-items-center mb-3">
        <div class="input-group input-group-sm local_edtutor-filter mr-2 my-1">
            <div class="input-group-prepend">
                <label class="input-group-text" for="local_edtutor-view">{{#str}} view {{/str}}</label>
            </div>
            <select class="custom-select" id="local_edtutor-view" data-action="local_edtutor-viewtoggle">
                <option value="bystudent" {{#bystudentactive}}selected{{/bystudentactive}}>
                    {{#str}} bystudent, local_edtutor {{/str}}
                </option>
                <option value="bycourse" {{#bycourseactive}}selected{{/bycourseactive}}>
                    {{#str}} bycourse, local_edtutor {{/str}}
                </option>
            </select>
        </div>
        <div class="input-group input-group-sm local_edtutor-filter mr-2 my-1">
            <div class="input-group-prepend">
                <label class="input-group-text" for="local_edtutor-filterstudent">
                    {{#str}} student, local_edtutor {{/str}}
                </label>
            </div>
            <select class="custom-select" id="local_edtutor-filterstudent" data-action="local_edtutor-filterstudent">
                <option value="all" selected>{{#str}} filterallstudents, local_edtutor {{/str}}</option>
                {{#filterstudents}}
                    <option value="{{id}}">{{label}}</option>
                {{/filterstudents}}
            </select>
        </div>
        <div class="input-group input-group-sm local_edtutor-filter mr-2 my-1">
            <div class="input-group-prepend">
                <label class="input-group-text" for="local_edtutor-filtercourse">{{#str}} course {{/str}}</label>
            </div>
            <select class="custom-select" id="local_edtutor-filtercourse" data-action="local_edtutor-filtercourse">
                <option value="all" selected>{{#str}} filterallcourses, local_edtutor {{/str}}</option>
                {{#filtercourses}}
                    <option value="{{id}}">{{fullname}}</option>
                {{/filtercourses}}
            </select>
        </div>
        <div class="input-group input-group-sm local_edtutor-filter my-1">
            <div class="input-group-prepend">
                <label class="input-group-text" for="local_edtutor-timeframe">
                    {{#str}} status, local_edtutor {{/str}}
                </label>
            </div>
            <select class="custom-select" id="local_edtutor-timeframe" data-action="local_edtutor-timeframe">
                <option value="all" {{#tfallselected}}selected{{/tfallselected}}>
                    {{#str}} timeframeall, local_edtutor {{/str}}
                </option>
                <option value="duesoon" {{#tfduesoonselected}}selected{{/tfduesoonselected}}>
                    {{#str}} timeframeduesoon, local_edtutor {{/str}}
                </option>
                <option value="overdue" {{#tfoverdueselected}}selected{{/tfoverdueselected}}>
                    {{#str}} timeframeoverdue, local_edtutor {{/str}}
                </option>
            </select>
        </div>
    </div>
    <div data-region="local_edtutor-view-bystudent" class="{{^bystudentactive}}d-none{{/bystudentactive}}">
        {{#students}}
            {{> local_edtutor/dashboard_student_card }}
        {{/students}}
        {{^hasstudents}}
            <div class="alert alert-info">{{#str}} nostudentsallocated, local_edtutor {{/str}}</div>
        {{/hasstudents}}
        {{#hasstudents}}
            <div class="alert alert-info {{^bystudentempty}}local_edtutor-hidden{{/bystudentempty}}"
                 data-region="local_edtutor-nomatches" aria-live="polite">
                {{#str}} nomatchingitems, local_edtutor {{/str}}
            </div>
        {{/hasstudents}}
    </div>
    <div data-region="local_edtutor-view-bycourse" class="{{^bycourseactive}}d-none{{/bycourseactive}}">
        {{#courses}}
            {{> local_edtutor/dashboard_course_card }}
        {{/courses}}
        {{^hascourses}}
            <div class="alert alert-info">{{#str}} nocourseswithstudents, local_edtutor {{/str}}</div>
        {{/hascourses}}
        {{#hascourses}}
            <div class="alert alert-info {{^bycourseempty}}local_edtutor-hidden{{/bycourseempty}}"
                 data-region="local_edtutor-nomatches" aria-live="polite">
                {{#str}} nomatchingitems, local_edtutor {{/str}}
            </div>
        {{/hascourses}}
    </div>
</div>
{{#js}}
require(['local_edtutor/dashboard'], function(dashboard) {
    dashboard.init();
});
{{/js}}
