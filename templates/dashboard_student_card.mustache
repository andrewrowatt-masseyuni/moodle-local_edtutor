{{!
    @template local_edtutor/dashboard_student_card

    One allocated student on the Education Tutor dashboard by-student view.

    The card lists the student's courses and the assignments and quizzes they
    can access in each, in due date order with activities that have no due
    date grouped below. A red left edge (styled in styles.css) emphasises the
    card only while it shows an overdue activity, so it clears when the filter
    hides every overdue row. The capability flags and preferences URL are
    inherited from the parent template context.

    Classes required for JS:
    * local_edtutor-hidden - Marker class applied to filtered-out elements.

    Classes required for CSS:
    * local_edtutor-block - On each course section; the red trim ignores overdue
      rows inside a hidden section (see styles.css).

    Data attributes required for JS:
    * data-region="local_edtutor-studentcard" with data-studentid
    * data-region="local_edtutor-coursesection" with data-courseid
    * data-region="local_edtutor-noduegroup"

    Context variables required for this template:
    * id - Student user id.
    * fullname - Student full name.
    * username - Student username (student ID).
    * lastaccess - Most recent course access, already formatted.
    * hidden - Whether the timeframe filter initially hides the whole card.
    * loginasurl - URL to log in as this student (includes sesskey). Each
      course also carries its own loginasurl with a courseid, so login-as
      from a course row lands in that course.
    * hascourses - Whether the student is enrolled in any course.
    * courses - Courses with their activities and submission statuses. Each
      carries hidden and noduehidden flags for the initial filtered render.

    Example context (json):
    {
        "id": 3,
        "fullname": "Student One",
        "username": "27010001",
        "lastaccess": "Tuesday, 1 July 2025, 9:00 AM",
        "hidden": false,
        "loginasurl": "https://example.com/local/edtutor/loginas.php?userid=3&sesskey=xyz",
        "hascourses": true,
        "courses": [
            {
                "id": 5,
                "fullname": "Course 1",
                "loginasurl": "https://example.com/local/edtutor/loginas.php?userid=3&courseid=5&sesskey=xyz",
                "lastaccess": "Tuesday, 1 July 2025, 9:00 AM",
                "hasactivities": true,
                "hasdueactivities": true,
                "hidden": false,
                "noduehidden": true,
                "activities": [
                    {
                        "cmid": 12,
                        "name": "Assignment 1",
                        "iconclass": "fa-solid fa-file-pen",
                        "submittable": true,
                        "submitted": false,
                        "hasduedate": true,
                        "duedate": "Friday, 4 July 2025, 5:00 PM",
                        "extension": true,
                        "overdue": true,
                        "timeframe": "overdue",
                        "assesshidden": false,
                        "hidden": false,
                        "submiturl": "https://example.com/local/edtutor/submit.php?studentid=3&courseid=5&cmid=12",
                        "hideurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=12&action=hide",
                        "showurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=12&action=show&sesskey=xyz"
                    }
                ],
                "hasnoduedate": true,
                "noduedateactivities": [
                    {
                        "cmid": 13,
                        "name": "Quiz 1",
                        "iconclass": "fa-solid fa-clipboard-question",
                        "submittable": false,
                        "submitted": false,
                        "hasduedate": false,
                        "duedate": "",
                        "extension": false,
                        "overdue": false,
                        "timeframe": "future",
                        "assesshidden": false,
                        "hidden": true,
                        "submiturl": "https://example.com/local/edtutor/submit.php?studentid=3&courseid=5&cmid=13",
                        "hideurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=13&action=hide",
                        "showurl": "https://example.com/local/edtutor/hide.php?studentid=3&courseid=5&cmid=13&action=show&sesskey=xyz"
                    }
                ]
            }
        ],
        "canloginas": true,
        "cansubmit": true,
        "cansetpreferences": true,
        "preferencesurl": "https://example.com/local/edtutor/preferences.php"
    }
}}
<div class="card mb-3 local_edtutor-card {{#hidden}}local_edtutor-hidden{{/hidden}}"
     data-region="local_edtutor-studentcard" data-studentid="{{id}}">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-start">
            <div class="mr-auto">
                <h5 class="card-title mb-1">
                    <i class="fa-solid fa-user mr-1" aria-hidden="true"></i>{{fullname}}
                    <small class="text-muted">({{username}})</small>
                </h5>
                <div class="small text-muted mb-2">
                    <i class="fa-solid fa-clock mr-1" aria-hidden="true"></i>
                    {{#str}} lastcourseaccess, local_edtutor {{/str}}: {{lastaccess}}
                </div>
            </div>
            {{#cansetpreferences}}
                <a class="btn btn-outline-secondary btn-sm" href="{{preferencesurl}}">
                    <i class="fa-solid fa-gear mr-1" aria-hidden="true"></i>
                    {{#str}} setstudentpreferences, local_edtutor {{/str}}
                </a>
            {{/cansetpreferences}}
        </div>
        {{#courses}}
            <div class="border-top pt-2 mt-2 local_edtutor-block {{#hidden}}local_edtutor-hidden{{/hidden}}"
                 data-region="local_edtutor-coursesection" data-courseid="{{id}}">
                <div class="d-flex flex-wrap align-items-center">
                    <h6 class="mb-0 mr-2">
                        <i class="fa-solid fa-graduation-cap mr-1" aria-hidden="true"></i>{{fullname}}
                    </h6>
                    <span class="small text-muted mr-auto">
                        {{#str}} lastcourseaccess, local_edtutor {{/str}}: {{lastaccess}}
                    </span>
                    {{#canloginas}}
                        <a class="btn btn-outline-primary btn-sm" href="{{loginasurl}}">
                            <i class="fa-solid fa-right-to-bracket mr-1" aria-hidden="true"></i>
                            {{#str}} loginas, local_edtutor {{/str}}
                        </a>
                    {{/canloginas}}
                </div>
                {{#hasdueactivities}}
                    <div class="list-group list-group-flush mt-1 ml-4">
                        {{#activities}}
                            {{> local_edtutor/dashboard_activity_row }}
                        {{/activities}}
                    </div>
                {{/hasdueactivities}}
                {{#hasnoduedate}}
                    <div data-region="local_edtutor-noduegroup" class="{{#noduehidden}}local_edtutor-hidden{{/noduehidden}}">
                        <h6 class="small text-muted mt-2 mb-0">{{#str}} noduedateheading, local_edtutor {{/str}}</h6>
                        <div class="list-group list-group-flush ml-4">
                            {{#noduedateactivities}}
                                {{> local_edtutor/dashboard_activity_row }}
                            {{/noduedateactivities}}
                        </div>
                    </div>
                {{/hasnoduedate}}
                {{^hasactivities}}
                    <p class="small text-muted mt-2 mb-0">{{#str}} noactivities, local_edtutor {{/str}}</p>
                {{/hasactivities}}
            </div>
        {{/courses}}
        {{^hascourses}}
            <p class="text-muted mb-0">{{#str}} nocourses, local_edtutor {{/str}}</p>
        {{/hascourses}}
    </div>
</div>
